{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/doc-width\"",
            "statusMessage": "Checking doc width",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/go-lint\"",
            "statusMessage": "Linting package",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/verify\"",
            "statusMessage": "Verifying",
            "timeout": 120
          }
        ]
      }
    ]
  }
}

#!/usr/bin/env bash
#
# PostToolUse(Write|Edit) adapter: lint the edited file's package as it is
# written.
#
# Triggers on any Go writes under the project root, tracked or not, in
# contrast to `mise run verify`.
#
# Scoped to run on the enclosing package so `golangci-lint` only costs ~0.3s.
#
# The `scratchpad/` folder is skipped deliberately: `CLAUDE.md` keeps probes
# there that are *meant* to trip a linter.
#
# Silence means clean. Exit 2 hands the violation back to Claude.
#
# Example:
#
# echo '{"tool_input":{"file_path":"'$PWD'/*/plan.go"}}' | .claude/hooks/go-lint

set -uo pipefail

root="${CLAUDE_PROJECT_DIR:-$PWD}"

# The hook payload arrives as JSON on stdin. Matches "$root/" rather than
# "$root", so a sibling checkout such as another git worktree is not triggered.
file=$(jq -r --arg root "$root" '
  .tool_input.file_path // empty
  | select(startswith($root + "/") and endswith(".go"))
  | select(startswith($root + "/scratchpad/") | not)
')

[ -n "$file" ] || exit 0

# Enforces that a check that could not run triggers an error.
cd "$root" || exit 2

package_dir=$(dirname "$file")

# Check on the exit code rather than raw output from `golangci-lint` and merges
# both `stdout` and `stderr` output to `out`.
out=$(mise exec -- golangci-lint run "$package_dir" 2>&1)
status=$?

if [ "$status" -ne 0 ]; then
  printf '%s\n' "$out" >&2
  exit 2
fi
